# MongoDB Database Connection URL (e.g., MongoDB Atlas or local MongoDB)
MONGO_URL=mongodb://localhost:27017

# Database Name
DB_NAME=price_aggregator

# Apify Scraping Configuration (Optional)
APIFY_TOKEN=your_apify_api_token_here
APIFY_MAX_ITEMS=15
APIFY_MAX_COST_USD=0.25
APIFY_CACHE_TTL_MINUTES=60

# Regional Marketplace Settings
FB_MARKETPLACE_CITY=medan
CAROUSELL_MARKET=id
OLX_COUNTRY=id

# Indexer Schedule (Hours)
INDEX_INTERVAL_HOURS=6

# Server Port
PORT=8000
